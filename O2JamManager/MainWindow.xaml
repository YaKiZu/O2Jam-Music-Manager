<Window x:Class="O2JamManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:O2JamManager.Converters"
        xmlns:vm="clr-namespace:O2JamManager.ViewModels"
        Title="O2Jam Music Manager"
        Icon="app_icon.ico"
        Height="840" Width="1380"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0b0b14"
        Foreground="#f1f5f9"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:StatusColorConverter x:Key="StatusColorConverter"/>
        <conv:StatusBackgroundConverter x:Key="StatusBackgroundConverter"/>
        <conv:StatusBorderConverter x:Key="StatusBorderConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Primary Neon Button Style (Violet to Pink gradient) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7c3aed" Offset="0"/>
                        <GradientStop Color="#ec4899" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#db2777"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#8b5cf6" Offset="0"/>
                                            <GradientStop Color="#f43f5e" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#f43f5e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Neon Button Style (Cyan to Indigo gradient) for Custom Reindex -->
        <Style x:Key="AccentNeonBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0284c7" Offset="0"/>
                        <GradientStop Color="#6366f1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0ea5e9" Offset="0"/>
                                            <GradientStop Color="#8b5cf6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#818cf8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#151d33"/>
            <Setter Property="Foreground" Value="#38bdf8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0284c7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0c4a6e"/>
                                <Setter Property="BorderBrush" Value="#38bdf8"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#29121c"/>
            <Setter Property="Foreground" Value="#fb7185"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#9f1239"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4c0519"/>
                                <Setter Property="BorderBrush" Value="#f43f5e"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav / Neutral Button Style -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="#18182e"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2e2e50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252546"/>
                                <Setter Property="BorderBrush" Value="#a855f7"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#16162a"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#2b2b48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#a855f7"/>
                                <Setter Property="Background" Value="#1c1c36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header (Title + Folder selection) -->
            <RowDefinition Height="Auto"/>
            <!-- Action Toolbar (Move up/down, Reindex, Add, Del, Search) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Splitter (Table + Edit Panel) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#121222" BorderBrush="#23233c" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title (Centré et équilibré dans le coin supérieur gauche) -->
                <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="4,4">
                    <TextBlock Text="O2Jam Music Manager"
                               FontSize="18"
                               FontWeight="ExtraBold"
                               Foreground="#f43f5e"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Folder selector -->
                <TextBlock Grid.Column="2" Text="{Binding MusicFolderLabel}" VerticalAlignment="Center" Foreground="#94a3b8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" Text="{Binding MusicDir, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="{Binding BrowseFolderText}" Style="{StaticResource SecondaryBtn}" Command="{Binding BrowseFolderCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="5" Content="{Binding RefreshFolderText}" Style="{StaticResource NavBtn}" Command="{Binding RefreshFolderCommand}" Margin="0,0,8,0"/>
            </Grid>
        </Border>

        <!-- 2. ACTION & FILTER TOOLBAR (Panel.ZIndex 100 for zero-popup dropdown overlay over DataGrid) -->
        <Border Grid.Row="1" Background="#121222" BorderBrush="#1e1e34" BorderThickness="0,0,0,1" Padding="16,8" Panel.ZIndex="100" ClipToBounds="False">
            <Grid ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ReindexText}" Style="{StaticResource PrimaryBtn}" Click="OnOpenReindexWindowClick" IsEnabled="{Binding IsNotBusy}" Margin="0,0,8,0"/>
                    <Button Content="{Binding ReindexCustomText}" Style="{StaticResource AccentNeonBtn}" Command="{Binding ReindexCustomCommand}" Margin="0,0,14,0"/>

                    <Rectangle Width="1" Height="22" Fill="#2a2a46" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <Button Content="{Binding GenerateOjnListText}" Style="{StaticResource NavBtn}" Command="{Binding GenerateOjnListCommand}" Margin="0,0,14,0"/>

                    <Rectangle Width="1" Height="22" Fill="#2a2a46" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <Button Content="{Binding AddSongText}" Style="{StaticResource SecondaryBtn}" Command="{Binding AddSongCommand}" Margin="0,0,6,0"/>
                    <Button Content="{Binding DeleteSongText}" Style="{StaticResource DangerBtn}" Command="{Binding DeleteSongCommand}"/>
                </StackPanel>

                <!-- Right Search & Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="False">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748b"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,10,0"/>

                    <ComboBox x:Name="StatusFilterComboBox"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="180"
                              MaxDropDownHeight="220"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. CENTRAL CONTENT (DATAGRID + EDIT PANEL) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left DataGrid (approx 70%) -->
                <ColumnDefinition Width="7*" MinWidth="550"/>
                <!-- Splitter -->
                <ColumnDefinition Width="4"/>
                <!-- Right Edit Panel (approx 30%) -->
                <ColumnDefinition Width="3*" MinWidth="340" MaxWidth="540"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DATAGRID -->
            <DataGrid Grid.Column="0"
                      x:Name="SongsGrid"
                      ItemsSource="{Binding FilteredSongs}"
                      SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="#0e0e1a"
                      Foreground="#f1f5f9"
                      RowBackground="#0e0e1a"
                      AlternatingRowBackground="#121222"
                      BorderThickness="0"
                      RowHeight="36"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="OnGridMouseDoubleClick">

                <DataGrid.ContextMenu>
                    <ContextMenu Background="#16162a" BorderBrush="#3b3b64" Foreground="#f1f5f9">
                        <MenuItem Header="{Binding PlayButtonText}" Command="{Binding TogglePlayCommand}"/>
                        <Separator Background="#2b2b48"/>
                        <MenuItem Header="{Binding CtxChangeCover}" Command="{Binding ChangeCoverCommand}"/>
                        <MenuItem Header="{Binding CtxChangeThumbnail}" Command="{Binding ChangeThumbnailCommand}"/>
                        <MenuItem Header="{Binding CtxChangeId}" Command="{Binding ChangeIdCommand}"/>
                        <Separator Background="#2b2b48"/>
                        <MenuItem Header="{Binding CtxMoveUp}" Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="{Binding CtxMoveDown}" Command="{Binding MoveDownCommand}"/>
                        <Separator Background="#2b2b48"/>
                        <MenuItem Header="{Binding CtxOpenFolder}" Command="{Binding OpenInExplorerCommand}"/>
                        <Separator Background="#2b2b48"/>
                        <MenuItem Header="{Binding CtxDelete}" Command="{Binding DeleteSongCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#15152a"/>
                        <Setter Property="Foreground" Value="#94a3b8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                        <Setter Property="BorderBrush" Value="#9d4edd"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              RecognizesAccessKey="True"/>
                                            <!-- Interactive Sort Indicator Arrow (▲ / ▼) -->
                                            <TextBlock x:Name="SortArrow"
                                                       Grid.Column="1"
                                                       Text=""
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#e056fd"
                                                       Margin="6,0,2,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1e1e38"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter TargetName="SortArrow" Property="Text" Value=" ▲"/>
                                            <Setter Property="Foreground" Value="#e056fd"/>
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter TargetName="SortArrow" Property="Text" Value=" ▼"/>
                                            <Setter Property="Foreground" Value="#e056fd"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="MinHeight" Value="36"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e1e36"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#6b21a8"/>
                                <Setter Property="BorderBrush" Value="#e056fd"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- ID Column -->
                    <DataGridTemplateColumn Header="ID" Width="50" SortMemberPath="SongId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SongId, Mode=OneTime}"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#c084fc"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- File .ojn -->
                    <DataGridTextColumn Header=".OJN FILE" Binding="{Binding FileName, Mode=OneTime}" SortMemberPath="OjnNaturalSortKey" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- File Audio .ojm -->
                    <DataGridTextColumn Header=".OJM FILE" Binding="{Binding OjmFile, Mode=OneTime}" SortMemberPath="OjmNaturalSortKey" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Title (Proportional 2*, fits dynamically with zero horizontal scroll) -->
                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title, Mode=OneTime}" Width="2*" MinWidth="130" CanUserResize="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Artist (Proportional 1*, fits dynamically with zero horizontal scroll) -->
                    <DataGridTextColumn Header="ARTIST" Binding="{Binding Artist, Mode=OneTime}" Width="1*" MinWidth="90" CanUserResize="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#cbd5e1"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Noter / Charter -->
                    <DataGridTextColumn Header="NOTER" Binding="{Binding Noter, Mode=OneTime}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94a3b8"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- BPM -->
                    <DataGridTextColumn Header="BPM" Binding="{Binding BpmDisplay, Mode=OneTime}" SortMemberPath="Bpm" Width="52">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#38bdf8"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Levels (Ex / Nx / Hx) -->
                    <DataGridTextColumn Header="LEVELS (EX/NX/HX)" Binding="{Binding LevelsDisplay, Mode=OneTime}" SortMemberPath="HardSortKey" Width="105">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Duration -->
                    <DataGridTextColumn Header="DURATION" Binding="{Binding DurationDisplay, Mode=OneTime}" SortMemberPath="MaxDuration" Width="58">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#cbd5e1"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status .ojm Badge -->
                    <DataGridTemplateColumn Header=".OJM STATUS" Width="90" SortMemberPath="OjmExists">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding OjmExists, Mode=OneTime, Converter={StaticResource StatusBackgroundConverter}}"
                                        BorderBrush="{Binding OjmExists, Mode=OneTime, Converter={StaticResource StatusBorderConverter}}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="8,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OjmStatusDisplay, Mode=OneTime}"
                                               Foreground="{Binding OjmExists, Mode=OneTime, Converter={StaticResource StatusColorConverter}}"
                                               FontWeight="Bold"
                                               FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#18182c" Cursor="SizeWE"/>

            <!-- RIGHT: EDIT & PREVIEW PANEL -->
            <Border Grid.Column="2" Background="#10101c" BorderBrush="#1e1e36" BorderThickness="1,0,0,0" ClipToBounds="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="False">
                    <StackPanel Margin="14" ClipToBounds="False">

                        <!-- COVER & THUMBNAIL CARD -->
                        <Border Background="#131324" BorderBrush="#252542" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Panel.ZIndex="1">
                            <StackPanel>
                                <TextBlock Text="{Binding CardCoverTitle}" Foreground="#c084fc" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                                <!-- Large Cover Image -->
                                <Border Background="#0b0b14" BorderBrush="#7c3aed" BorderThickness="2" CornerRadius="6" Height="180" Margin="0,0,0,10"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeCoverCommand}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <TextBlock Text="{Binding NoCoverJpg}"
                                                   Foreground="#475569"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Image Source="{Binding CoverImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <!-- Thumbnail & Details Row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Crisp Thumbnail -->
                                    <Border Grid.Column="0" Background="#0b0b14" BorderBrush="#ec4899" BorderThickness="2" CornerRadius="6" Width="64" Height="64" ClipToBounds="True"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeThumbnailCommand}"/>
                                        </Border.InputBindings>
                                        <Image Source="{Binding ThumbnailImage}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Info Labels -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CoverInfoText}" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ThumbInfoText}" Foreground="#94a3b8" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Cover action buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding BtnCoverText}" Style="{StaticResource SecondaryBtn}" Command="{Binding ChangeCoverCommand}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="{Binding BtnThumbText}" Style="{StaticResource SecondaryBtn}" Command="{Binding ChangeThumbnailCommand}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="2" Content="{Binding BtnExportText}" Style="{StaticResource NavBtn}" Command="{Binding ExportCoverCommand}" Padding="10,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- AUDIO PLAYER / COMPLETE SONG (.OJN + .OJM) -->
                        <Border Background="#131324" BorderBrush="#252542" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Panel.ZIndex="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CardAudioTitle}" Foreground="#ec4899" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AudioStatusText}" Foreground="#a855f7" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                </Grid>

                                <!-- Play/Pause/Stop Buttons + Time -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Play / Pause -->
                                    <Button Grid.Column="0"
                                            Content="{Binding PlayPauseButtonText}"
                                            Command="{Binding TogglePlayCommand}"
                                            Style="{StaticResource PrimaryBtn}"
                                            Height="36"
                                            Margin="0,0,6,0"/>

                                    <!-- Stop -->
                                    <Button Grid.Column="1"
                                            Content="{Binding BtnStop}"
                                            Command="{Binding StopAudioCommand}"
                                            Style="{StaticResource NavBtn}"
                                            Height="36"
                                            Margin="0,0,8,0"/>

                                    <!-- Time Display -->
                                    <Border Grid.Column="2" Background="#0b0b14" BorderBrush="#3b3b64" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AudioTimeDisplay}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#38bdf8"/>
                                    </Border>
                                </Grid>

                                <!-- Progress Slider -->
                                <Slider x:Name="AudioProgressSlider"
                                        Minimum="0"
                                        Maximum="{Binding AudioDuration}"
                                        Value="{Binding AudioPosition, Mode=OneWay}"
                                        Margin="0,0,0,8"
                                        PreviewMouseDown="OnSliderMouseDown"
                                        PreviewMouseUp="OnSliderMouseUp"/>

                                <!-- Volume Control Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LblVolume}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <Slider Grid.Column="2"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="{Binding AudioVolume, Mode=TwoWay}"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding AudioVolumePercentDisplay}"
                                               Foreground="#38bdf8"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Width="38"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"/>
                                </Grid>

                                <!-- DIAGNOSTIC LOGS / INFO BAR -->
                                <Border Background="#0d0d18" BorderBrush="#262646" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding DiagnosticInfoText}"
                                               Foreground="#94a3b8"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- METADATA FORM CARD (Panel.ZIndex 999 to float over Technical Details) -->
                        <Border Background="#131324" BorderBrush="#252542" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Panel.ZIndex="999" ClipToBounds="False">
                            <StackPanel ClipToBounds="False">
                                <TextBlock Text="{Binding CardMetadataTitle}" Foreground="#38bdf8" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>

                                <!-- Song ID -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LblSongId}" Foreground="#94a3b8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1" Text="{Binding EditSongId, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    <Button Grid.Column="3" Content="{Binding BtnRenameId}" Style="{StaticResource SecondaryBtn}" Command="{Binding ChangeIdCommand}"/>
                                </Grid>

                                <!-- Title -->
                                <TextBlock Text="{Binding LblTitle}" Foreground="#94a3b8" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,0,0,8"/>

                                <!-- Artist -->
                                <TextBlock Text="{Binding LblArtist}" Foreground="#94a3b8" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding EditArtist, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Margin="0,0,0,8"/>

                                <!-- Noter / Charter -->
                                <TextBlock Text="{Binding LblNoter}" Foreground="#94a3b8" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding EditNoter, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Margin="0,0,0,8"/>

                                <!-- BPM & Genre Row (ZIndex 999 so dropdown floats over lower fields and cards) -->
                                <Grid Margin="0,0,0,8" ClipToBounds="False" Panel.ZIndex="999">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding LblBpm}" Foreground="#94a3b8" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding EditBpm, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" ClipToBounds="False" Panel.ZIndex="999">
                                        <TextBlock Text="{Binding LblGenre}" Foreground="#94a3b8" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="GenreComboBox"
                                                  Panel.ZIndex="999"
                                                  ClipToBounds="False"
                                                  ItemsSource="{Binding Genres}"
                                                  SelectedIndex="{Binding EditGenreIndex}"
                                                  MaxDropDownHeight="220"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Levels (Ex / Nx / Hx) -->
                                <TextBlock Text="{Binding LblLevelsGroup}" Foreground="#94a3b8" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding LblEx}" Foreground="#38bdf8" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditLevelEx, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding LblNx}" Foreground="#fbbf24" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditLevelNx, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding LblHx}" Foreground="#f43f5e" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditLevelHx, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Save Button -->
                                <Button Content="{Binding BtnSaveMetadata}"
                                        Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding SaveMetadataCommand}"
                                        Height="40"/>
                            </StackPanel>
                        </Border>

                        <!-- TECHNICAL CHART DETAILS CARD (Panel.ZIndex 1) -->
                        <Border Background="#131324" BorderBrush="#252542" BorderThickness="1" CornerRadius="8" Padding="12" Panel.ZIndex="1">
                            <StackPanel>
                                <TextBlock Text="{Binding CardTechTitle}" Foreground="#a855f7" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LblTechOjn}" Foreground="#64748b" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSong.FileName, FallbackValue='-'}" Foreground="#cbd5e1" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LblTechOjm}" Foreground="#64748b" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSong.OjmFile, FallbackValue='-'}" Foreground="#cbd5e1" FontSize="11"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LblTechDurations}" Foreground="#64748b" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSong.DurationsAll, FallbackValue='-'}" Foreground="#cbd5e1" FontSize="11"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LblTechNotes}" Foreground="#64748b" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSong.NotesAll, FallbackValue='-'}" Foreground="#cbd5e1" FontSize="11"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LblTechSizeOjn}" Foreground="#64748b" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSong.OjnFileSizeDisplay, FallbackValue='-'}" Foreground="#cbd5e1" FontSize="11"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LblTechSizeOjm}" Foreground="#64748b" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSong.OjmFileSizeDisplay, FallbackValue='-'}" Foreground="#cbd5e1" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. STATUS BAR -->
        <Border Grid.Row="3" Background="#0c0c16" BorderBrush="#1a1a2e" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding TotalCountText}" Foreground="#94a3b8" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="{Binding OjmStatsText}" Foreground="#cbd5e1" FontSize="12"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <ProgressBar Width="120" Height="8"
                                 Value="{Binding ProgressValue}"
                                 Maximum="{Binding ProgressMax}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                 Background="#1e1e36" Foreground="#ec4899" BorderThickness="0" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#a855f7" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Foreground="#64748b" FontSize="12">
                    <Run Text="{Binding StatusSelection, Mode=OneWay}"/>
                    <Run Text="{Binding SelectedSong.FileName, FallbackValue='-', Mode=OneWay}" Foreground="#c084fc" FontWeight="Bold"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
